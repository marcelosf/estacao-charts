################################################
# Nome das variáveis para o Local Storage
################################################
MIX_DATA_INTERVAL_STORAGE=          dataInterval
MIX_PRESSURE_STORAGE=               pressure
MIX_WIND_STORAGE=                   wind
MIX_PRECIPITATION_STORAGE=          precipitation

################################################
# Url para aquisição dos dados
################################################
MIX_API=                            consulta/charts/loadtseco.php

################################################
# Id dos campos do formulário de busca
################################################
MIX_PRESSURE_INI_DATE_FIELD=        '#pressure-ini-date-field'
MIX_PRESSURE_END_DATE_FIELD=        '#pressure-end-date-field'
MIX_WIND_INI_DATE_FIELD=            '#wind-ini-date-field'
MIX_WIND_END_DATE_FIELD=            '#wind-end-date-field'
MIX_PRECIPITATION_INI_DATE_FIELD=   '#precipitation-ini-date-field'
MIX_PRECIPITATION_END_DATE_FIELD=   '#precipitation-end-date-field'

################################################
# Tamanho da fonte do gráfico
################################################
MIX_CHART_LABLE_SIZE=               18

#################################################
# URL para o diretório de imagens.
# Esta URL é utilizada também para determinar
# onde estão as imagens de direção apresentadas 
# no gráfico do Vento
#################################################
MIX_IMAGES=                         http://www.estacao.iag.usp.br/consulta/charts/images/